# Stage 1: ใช้ Node 22 เวอร์ชันเต็มในการ Build
FROM node:22 AS build-stage
WORKDIR /app

COPY package*.json ./
RUN npm install --legacy-peer-deps --loglevel warn

COPY . .
RUN npm run build

# Stage 2: นำไฟล์ที่ Build เสร็จไปรันบน Nginx
FROM nginx:alpine

# 1. คัดลอกไฟล์คอนฟิก Nginx ตัวใหม่ที่เราเพิ่งสร้าง เข้าไปในตัว Docker
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 2. คัดลอกไฟล์แอปพลิเคชัน Angular ที่ build เสร็จแล้ว
COPY --from=build-stage /app/dist/talent-hub-web/browser /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
