# Stage 1: Build source code ด้วย Gradle
FROM gradle:8-jdk17 AS build-stage
WORKDIR /app
COPY build.gradle settings.gradle ./
COPY src ./src
RUN gradle clean bootJar -x test --no-daemon

# Stage 2: เปลี่ยนมาใช้เวอร์ชัน -jammy เพื่อให้รองรับชิปทุกแบบ (M1/M2/M3/Intel/AMD)
FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

# ─── ฝังการตั้งค่า Timezone ประเทศไทย (Asia/Bangkok) ───
ENV TZ=Asia/Bangkok
RUN apt-get update && apt-get install -y tzdata && \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
# ──────────────────────────────────────────────────

# คัดลอกไฟล์ผลลัพธ์จากสเตจที่ 1 มาใช้งาน (สำหรับ Gradle ไฟล์จะอยู่ใน build/libs)
COPY --from=build-stage /app/build/libs/*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
